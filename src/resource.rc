#include <windows.h>
#include "resource.h"

IDI_APP ICON "app.ico"
1 RT_MANIFEST "app.manifest"

IDD_CLOCK DIALOGEX 0, 0, 290, 252
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add clock"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Search a city, country, or time zone:", -1, 10, 8, 270, 10
    EDITTEXT        IDC_SEARCH, 10, 20, 270, 14, ES_AUTOHSCROLL
    LISTBOX         IDC_LIST, 10, 40, 270, 124, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_PREVIEW, 10, 168, 270, 10
    LTEXT           "Label:", -1, 10, 186, 30, 10
    EDITTEXT        IDC_LABEL, 42, 184, 238, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "Show this clock on the taskbar", IDC_TASKBAR, 10, 206, 200, 10
    DEFPUSHBUTTON   "OK", IDOK, 172, 228, 52, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 228, 228, 52, 14
END

IDD_ALARM DIALOGEX 0, 0, 240, 184
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add alarm / countdown"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Name:", -1, 10, 11, 56, 10
    EDITTEXT        IDC_ALABEL, 70, 9, 160, 14, ES_AUTOHSCROLL
    LTEXT           "Time:", -1, 10, 31, 56, 10
    EDITTEXT        IDC_ATIME, 70, 29, 64, 14, ES_AUTOHSCROLL
    LTEXT           "e.g. 9:30 am, 17:45", -1, 140, 31, 92, 10
    LTEXT           "In which clock:", -1, 10, 51, 58, 10
    COMBOBOX        IDC_ACLOCK, 70, 49, 160, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Repeat:", -1, 10, 71, 56, 10
    COMBOBOX        IDC_AREPEAT, 70, 69, 160, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Date (optional):", -1, 10, 91, 58, 10
    EDITTEXT        IDC_ADATE, 70, 89, 64, 14, ES_AUTOHSCROLL
    LTEXT           "YYYY-MM-DD for a one-off countdown", -1, 140, 87, 92, 18
    LTEXT           "", IDC_APREVIEW, 10, 112, 220, 28
    AUTOCHECKBOX    "Enabled", IDC_AENABLED, 10, 146, 80, 10
    DEFPUSHBUTTON   "OK", IDOK, 124, 164, 52, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 180, 164, 52, 14
END

IDD_JUMP DIALOGEX 0, 0, 230, 122
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Jump to a time"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Show every clock at this time in:", -1, 10, 8, 210, 10
    COMBOBOX        IDC_JCLOCK, 10, 20, 210, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Time (15:30, 3:30 pm, 3pm):", -1, 10, 40, 120, 10
    EDITTEXT        IDC_JTIME, 10, 52, 100, 14, ES_AUTOHSCROLL
    COMBOBOX        IDC_JDAY, 120, 52, 100, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_JPREVIEW, 10, 74, 210, 20
    DEFPUSHBUTTON   "Show", IDOK, 114, 100, 52, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 168, 100, 52, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "WinClock"
      VALUE "FileDescription", "WinClock - World clocks for desktop and taskbar"
      VALUE "FileVersion", "2.0.0"
      VALUE "ProductName", "WinClock"
      VALUE "ProductVersion", "2.0.0"
      VALUE "OriginalFilename", "WinClock.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
